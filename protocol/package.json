{
  "name": "@aegis/protocol",
  "version": "1.0.0",
  "private": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "node ./scripts/check-node-version.js",
    "pretest": "node ./scripts/check-node-version.js",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "build": "hardhat compile",
    "hardhat:sonic": "hardhat --network sonic",
    "hardhat:sonic-testnet": "hardhat --network sonicTestnet",
    "test": "hardhat test",
    "test:trading": "hardhat test test/dex/SignedLimitOrderRegistry.spec.js test/dex/RFQIntentSettlement.spec.js test/tokendistribution/TokenDistributionSale.spec.js test/tokendistribution/AuctionPriceLib.test.js",
    "test:privacy-relay": "hardhat test test/privacy/MockPrivacyEntryRelay.test.js test/privacy/PrivacyEntryRouter.test.js test/privacy/ZkPublicLayoutInvariants.test.js",
    "test:incentives": "hardhat test test/incentives/LiquidityMiningGauge.spec.js test/treasury/TreasuryBondAuction.spec.js",
    "test:staged-capital": "hardhat test test/crowdfunding/StagedCapitalVault.spec.js",
    "test:ecosystem": "hardhat test test/ecosystem/local-integration.test.js test/ecosystem/RelayerMarketplace.test.js test/governance/ShieldedGovernanceTally.test.js test/lending/CreditGatedBorrow.test.js",
    "production:preflight": "npm run compile && npm test && npm run circuits:validate && node scripts/production-preflight-circom.js",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:fuzz": "cross-env FUZZ_RUNS=22 hardhat test test/property/all.property.ts --grep property",
    "size": "hardhat size-contracts",
    "lint": "npm run lint:solhint",
    "lint:solhint": "solhint 'contracts/**/*.sol'",
    "audit:slither": "python analyze_slither.py",
    "audit:slither:scan": "slither . --config-file .slither.config.json --json slither-report.json --disable-color",
    "audit:slither:print": "slither . --config-file .slither.config.json --disable-color",
    "audit:slither:gate": "node scripts/security/slither-gate.mjs",
    "circuits:validate": "node scripts/ceremony/validate-circuits.js",
    "circuits:build-lending-split-dev": "node scripts/circuits/build-lending-split-dev.mjs",
    "circuits:auction-alignment": "node scripts/circuits/auction-math-alignment.mjs",
    "circuits:auction-snark-e2e": "node scripts/circuits/auction-snark-e2e.mjs",
    "circuits:aggregator-snark-e2e": "node scripts/circuits/aggregator-snark-e2e.mjs",
    "circuits:private-amm-snark-e2e": "node scripts/circuits/private-amm-snark-e2e.mjs",
    "circuits:sybil-snark-e2e": "node scripts/circuits/sybil-protection-snark-e2e.mjs",
    "circuits:tokendistribution-snark-e2e": "node scripts/circuits/tokendistribution-snark-e2e.mjs",
    "circuits:private-token-circom-compile-smoke": "node scripts/circuits/private-token-circom-compile-smoke.mjs",
    "circuits:build-keys": "node scripts/circuits/build-keys.js",
    "circuits:prepare-analytics": "node scripts/circuits/prepare-analytics.js",
    "circuits:prepare-spartan": "node scripts/circuits/prepare-spartan.js",
    "fuzz": "hardhat run scripts/fuzz/run-fuzz.ts",
    "sync:chain-pack": "node ./scripts/build-sonic-chain-pack.js"
  },
  "directories": {
    "test": "test"
  },
  "auditConfig": {
    "ignore": [
      "GHSA-848j-6mx2-7j84"
    ]
  },
  "overrides": {
    "tmp": "^0.2.6",
    "cookie": "0.7.0",
