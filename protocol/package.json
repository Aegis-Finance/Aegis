      "@openzeppelin/contracts-upgradeable-4.7.3": "npm:@openzeppelin/contracts-upgradeable@^5.4.0"
    },
    "elliptic": "^6.6.1",
    "js-yaml": "^4.2.0"
  },
  "dependencies": {
    "@arbitrum/nitro-contracts": "^3.1.1",
