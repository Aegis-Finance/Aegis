    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/hardhat-upgrades": "^3.0.4",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@viz-js/viz": "^3.28.0",
    "@zk-kit/incremental-merkle-tree": "^1.1.0",
    "chai": "^4.3.10",
    "circomlibjs": "^0.1.7",
    "cross-env": "^7.0.3",
    "fast-check": "^3.18.0",
    "hardhat": "^2.27.0",
    "hardhat-contract-sizer": "^2.10.1",
    "hardhat-gas-reporter": "^2.3.0",
    "hardhat-tracer": "^3.4.0",
    "husky": "^9.0.11",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "snarkjs": "^0.7.5",
    "solhint": "^3.6.2",
    "typechain": "^8.3.2"
