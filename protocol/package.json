    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "big-integer": "^1.6.52",
    "circomlib": "^2.0.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.14.0",
    "marked": "^12.0.2",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^24.31.0"
