    "undici": "^6.24.0",
    "uuid": "^11.1.1",
    "ws": "^8.18.0",
    "mocha": {
      "serialize-javascript": "^7.0.5"
    },
    "@arbitrum/nitro-contracts": {
      "@openzeppelin/contracts": "^5.4.0",
      "@openzeppelin/contracts-upgradeable": "^5.4.0"
    },
    "@offchainlabs/upgrade-executor": {
      "@openzeppelin/contracts": "^5.4.0",
