{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "hardhat"]
  },
  "include": [
    "hardhat.config.*",
    "scripts/**/*",
    "test/**/*",
    "formal-verification/**/*.ts",
    "typechain-types/**/*"
  ],
}

