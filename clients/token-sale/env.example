# Omni-chain / RPC / privacy: docs/OMNICHAIN_PRIVACY_AND_RPC.md
# Phase-A defaults (RPC bar, fingerprinting): docs/PRIVACY_DEFAULTS_AND_FINGERPRINTING.md
# Monorepo operator map (gen:frontend-env, NETWORK, gateways): docs/STACK_ALIGNMENT.md
# Maximum-privacy program: docs/AEGIS_HIDDEN_FORT_EXECUTION_PLAN.md
#
# Operational native-app bundle (local RPC + circuits only):
#   FRONTEND_BUILD_PROFILE=operational npm run gen:frontend-env
# See docs/ops/OPERATIONAL_FRONTEND_BUILD.md
#
# Arweave / public Sonic (default — no extra steps for users):
#   npm run gen:frontend-env
#   VITE_OPERATIONAL_PROFILE=0  VITE_RPC_URL=https://rpc.soniclabs.com
#
# This package is the **TGE / token distribution** microsite (Dutch auction + claims).
# The **main** DAO console is `../frontend/` (post-distribution; no in-app TGE auction — use this package for the sale window).
#
VITE_RPC_URL=https://rpc.testnet.soniclabs.com
# Optional: your own or DAO-operated HTTPS JSON-RPC (hostname is auto-trusted for custom RPC)
# VITE_DAO_RPC_URL=https://rpc.yourdao.example.com

VITE_CHAIN_ID=14601
VITE_AUCTION_ADDRESS=0x61821dF0886F7E79Ec39b43C9386C936e660F9a1
VITE_EXPLORER_URL=https://testnet.sonicscan.org
VITE_PROVER_URL=

# Default purchase tab: when VITE_PROVER_URL is set, the UI opens **ZK (recommended)** unless you force legacy below.
# VITE_TGE_DEFAULT_PURCHASE_MODE=legacy

# Optional: documentation URL for sale / claim / economics (shown in UI when set)
# VITE_SALE_DOCS_URL=https://example.com/docs/token-sale

# Optional: HTTPS base of `Aegis-contracts/docs` for footer links (economics framing, market risk note, FLOW-M5 specs).
# Example (GitHub): https://github.com/your-org/your-repo/blob/main/Aegis-contracts/docs
# VITE_REPO_DOCS_BASE_URL=https://github.com/your-org/your-repo/blob/main/Aegis-contracts/docs

# Etherscan API V2 (optional — if you add explorer-style calls from this app)
# VITE_ETHERSCAN_API_KEY=

# Optional: comma-separated hostnames allowed for custom RPC (HTTPS only, in addition to *.soniclabs.com and localhost)
# VITE_TRUSTED_RPC_HOSTS=my-rpc.internal.example.com

# DDoS / rate-limit client id: default is session-only (no canvas/WebGL/audio). Opt in to legacy fingerprint:
# VITE_ENABLE_CLIENT_FINGERPRINT=1

# Deployed Contracts (Sonic Testnet)
# Governance
VITE_GOVERNANCE_ADDRESS=0x96323f12E72Fc0ad8833E03B859A4e37402a7139
VITE_GOVERNANCE_TREASURY_ADDRESS=0x346690742E1847891cF85c3558c7633b496C4C51

# Treasury & Liquidity
VITE_TREASURYLIQUIDITYALLOCATOR_ADDRESS=0x3681DFaC0a6A439882b76078F69a2D8FBf896a46
VITE_PUBLIC_LIQUIDITY_POOL_ADDRESS=0xD7c29aC1E56d2E5720A30890F491E54AE2e5A5aE

# Cross-Chain Bridge
VITE_CROSS_CHAIN_BRIDGE_ADDRESS=0x5198351b89371C06DCC0195664836cAdadf81718

# Privacy entry router (optional — EIP-712 relay for PrivateTokenContract when `publicEntryEnabled` is false)
# Deploy: `npm run deploy:privacy-entry-router -- --network <sonic|sonicTestnet>` in Aegis-contracts, then `npm run gen:frontend-env`.
# Governance must authorizeContract(router) on the token before closing public entry (see docs/PRIVATE_TOKEN_AUTHORIZE_CONTRACT_MATRIX.md).
# Token ZK rails use dedicated VerifierFactory types (`mint-optimized`, `transfer-unshield`, `shielded-transfer`, …); see Aegis-contracts/docs/CIRCUIT_TO_CONTRACT_MAP.md.
# VITE_PRIVACY_ENTRY_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# Optional gasless relay (see Aegis-contracts/docs/ops/PRIVACY_ENTRY_RELAYER.md):
# VITE_PRIVACY_RELAY_HTTP_URL=http://127.0.0.1:8787
# VITE_PRIVACY_RELAY_API_KEY=
# VITE_DEFAULT_GASLESS_RELAY=1

# StagedCapitalVault (optional — VC-style milestone funding; same as main frontend)
# VITE_STAGED_CAPITAL_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# AutomatedBondingCurve (optional — post-auction; set when deployed)
# VITE_BONDING_CURVE_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: verifier + artifact manifest (generated under Aegis-contracts, copied to public/config/)
# VITE_VERIFIER_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# DAO incentives + treasury notes (optional — populated by `npm run gen:frontend-env` in Aegis-contracts when deployed)
# VITE_LIQUIDITY_MINING_GAUGE_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_TREASURY_BOND_AUCTION_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: ZK-gated allowlist sale (`TokenDistributionSale` — see Aegis-contracts/contracts/tokendistribution/README.md)
# VITE_TOKEN_DISTRIBUTION_SALE_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_TOKENDISTRIBUTION_WASM=circuits/tokendistribution/tokendistribution.wasm
# VITE_TOKENDISTRIBUTION_ZKEY=circuits/tokendistribution/tokendistribution_final.zkey

# VITE_VERIFIER_ARTIFACT_MANIFEST=config/verifier-artifact-manifest.json

# Optional: GovernanceCore / liquidity deployer / purchase limits / ceremony / FeeM (set after deploy)
# VITE_GOVERNANCE_CORE_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_AUTOMATED_LIQUIDITY_DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_TIME_LOCK_PURCHASE_LIMITS_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_CEREMONY_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_FEEM_GOVERNANCE_EXTENSION_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_AGS_FEE_MONETIZATION_ADDRESS=0x0000000000000000000000000000000000000000

# ZK Circuit Artifacts (local dev paths or Arweave/IPFS)
# Auction purchase
VITE_AUCTION_CIRCUIT_WASM=circuits/auction/auction.wasm
VITE_AUCTION_CIRCUIT_ZKEY=circuits/auction/auction_final.zkey
# Auction claim
VITE_AUCTION_CLAIM_WASM=circuits/auction-claim/claim.wasm
VITE_AUCTION_CLAIM_ZKEY=circuits/auction-claim/claim_final.zkey

# Bonding curve (optional — when circuits are built and hosted)
# VITE_BONDING_CURVE_PURCHASE_WASM=circuits/bonding-curve-purchase/bonding_curve_purchase.wasm
# VITE_BONDING_CURVE_PURCHASE_ZKEY=circuits/bonding-curve-purchase/bonding_curve_purchase_final.zkey
# VITE_BONDING_CURVE_SELL_WASM=circuits/bonding-curve-sell/bonding_curve_sell.wasm
# VITE_BONDING_CURVE_SELL_ZKEY=circuits/bonding-curve-sell/bonding_curve_sell_final.zkey

# Optional multi-gateway configuration
# Comma-separated gateway bases. The app will try each in order.
VITE_ARWEAVE_GATEWAYS=https://arweave.net,https://arweave.dev,https://gateway.irys.xyz
VITE_IPFS_GATEWAYS=https://ipfs.io/ipfs,https://cloudflare-ipfs.com/ipfs
VITE_LOCAL_MIRROR=

# Token Lists (for logos/metadata)
VITE_TOKENLIST_URLS=tokenlists/aegis.tokenlist.json
